# NVIDIA API Catalog (chat and embeddings)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Local MongoDB: start with npm run db:up
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=focalpoint
MONGODB_VECTOR_SEARCH=local

# For Atlas, use your Atlas URI and MONGODB_VECTOR_SEARCH=atlas.

# Change both together if another app uses port 8000.
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
