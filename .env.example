# Copy to .env and fill in. Never commit .env.

# Database (Docker Postgres on host port 5434)
DATABASE_URL=postgresql+psycopg://covora:covora@localhost:5434/covora
TEST_DATABASE_URL=postgresql+psycopg://covora:covora@localhost:5434/covora_test

# NVIDIA (build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_STRUCTURED_MODE=response_format
NEMOTRON_NANO_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NEMOTRON_EMBED_DIM=2048

# Model gateway
ROUTING_MODE=fixed
NANO_TIMEOUT_S=60
SUPER_TIMEOUT_S=180
NANO_CONCURRENCY=8
SUPER_CONCURRENCY=4
RETRY_BASE_DELAY_S=1.0
# JSON map of model id -> {"input_per_m": float, "output_per_m": float}; costs shown as estimates
MODEL_PRICES={}
LOG_LLM_PAYLOADS=true
# JSON list of tasks that run with model reasoning on, e.g. ["learning_analysis"]. Default: none.
REASONING_TASKS=[]
# Memory ablation, per agent: MEMORY_ENABLED_<AGENT>=false (e.g. MEMORY_ENABLED_ICP=false)

# You.com
YDC_API_KEY=
YOUCOM_BUDGET_USD=80

# Google OAuth (Gmail) — needed from Plan 3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:5180
